@page "/profesional/seguimiento"

@layout TEAprendo.Client.Layout.ProfesionalLayout

@using System.Globalization
@using System.Net.Http.Json
@using TEAprendo.Contracts.Profesional
@using TEAprendo.Contracts.Seguimiento

@inject HttpClient Http

<PageTitle>Seguimiento - TEAprendo</PageTitle>


<div class="tracking-page">

    <div class="page-header">

        <div>

            <span class="page-eyebrow">
                Seguimiento
            </span>

            <h1>
                Observaciones conductuales
            </h1>

            <p>
                Registra y consulta el seguimiento
                de tus estudiantes.
            </p>

        </div>


        <button type="button"
                class="btn-new-observation"
                @onclick="NuevaObservacion">

            <span>＋</span>

            Nueva observación

        </button>

    </div>


    @if (!string.IsNullOrWhiteSpace(_mensaje))
    {
        <div class="alert alert-success">
            @_mensaje
        </div>
    }


    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">
            @_error
        </div>
    }


    @* =========================
       Formulario
       ========================= *@

    @if (_mostrarFormulario)
    {
        <section class="observation-form">

            <div class="form-header">

                <div>

                    <span class="page-eyebrow">
                        Nuevo registro
                    </span>

                    <h2>
                        Observación conductual
                    </h2>

                </div>


                <button type="button"
                        class="close-button"
                        @onclick="CerrarFormulario">

                    ×

                </button>

            </div>


            <div class="form-grid">

                <div class="form-field">

                    <label>
                        Estudiante
                    </label>

                    <select class="form-select"
                            @bind="_form.AlumnoId">

                        <option value="@Guid.Empty">
                            Selecciona un estudiante
                        </option>

                        @foreach (var alumno in _alumnos)
                        {
                            <option value="@alumno.Id">

                                @alumno.Nombre
                                @alumno.Apellido
                                ·
                                @alumno.AulaNombre

                            </option>
                        }

                    </select>

                </div>


                <div class="form-field">

                    <label>
                        Fecha y hora de observación
                    </label>

                    <input type="datetime-local"
                           class="form-control"
                           value="@_form.FechaTexto"
                           @onchange="CambiarFecha" />

                </div>


                <div class="form-field form-full">

                    <label>
                        Contexto
                    </label>

                    <textarea class="form-control"
                              rows="3"
                              maxlength="1000"
                              placeholder="Ej: Actividad grupal en el aula..."
                              @bind="_form.Contexto">
                    </textarea>

                    <small>
                        Describe dónde y en qué situación
                        ocurrió la observación.
                    </small>

                </div>


                <div class="form-field form-full">

                    <label>
                        Conducta observada
                    </label>

                    <textarea class="form-control"
                              rows="4"
                              maxlength="1500"
                              placeholder="Describe objetivamente la conducta observada..."
                              @bind="_form.Conducta">
                    </textarea>

                </div>


                <div class="form-field">

                    <label>
                        Antecedente
                        <span>(opcional)</span>
                    </label>

                    <textarea class="form-control"
                              rows="3"
                              maxlength="1000"
                              placeholder="¿Qué ocurrió antes?"
                              @bind="_form.Antecedente">
                    </textarea>

                </div>


                <div class="form-field">

                    <label>
                        Consecuencia
                        <span>(opcional)</span>
                    </label>

                    <textarea class="form-control"
                              rows="3"
                              maxlength="1000"
                              placeholder="¿Qué ocurrió después?"
                              @bind="_form.Consecuencia">
                    </textarea>

                </div>


                <div class="form-field form-full">

                    <label>
                        Notas adicionales
                        <span>(opcional)</span>
                    </label>

                    <textarea class="form-control"
                              rows="3"
                              maxlength="1500"
                              placeholder="Información adicional relevante..."
                              @bind="_form.Notas">
                    </textarea>

                </div>

            </div>


            <div class="form-actions">

                <button type="button"
                        class="btn-cancel"
                        @onclick="CerrarFormulario">

                    Cancelar

                </button>


                <button type="button"
                        class="btn-save"
                        disabled="@_guardando"
                        @onclick="GuardarObservacion">

                    @(_guardando
                        ? "Registrando..."
                        : "Registrar observación")

                </button>

            </div>

        </section>
    }


    @* =========================
       Resumen
       ========================= *@

    <section class="tracking-stats">

        <article>

            <span>
                Total de observaciones
            </span>

            <strong>
                @_observaciones.Count
            </strong>

        </article>


        <article>

            <span>
                Registradas hoy
            </span>

            <strong>
                @ObservacionesHoy.Count
            </strong>

        </article>


        <article>

            <span>
                Estudiantes con seguimiento
            </span>

            <strong>
                @EstudiantesConSeguimiento
            </strong>

        </article>

    </section>


    @* =========================
       Historial
       ========================= *@

    <section class="history-section">

        <div class="history-header">

            <div>

                <span class="page-eyebrow">
                    Historial
                </span>

                <h2>
                    Observaciones registradas
                </h2>

                <p>
                    Consulta el historial de los estudiantes
                    que tienes autorizados.
                </p>

            </div>


            <div class="history-filter">

                <label>
                    Filtrar estudiante
                </label>

                <select class="form-select"
                        value="@ObtenerValorFiltro()"
                        @onchange="CambiarFiltroAlumno">

                    <option value="">
                        Todos los estudiantes
                    </option>

                    @foreach (var alumno in _alumnos)
                    {
                        <option value="@alumno.Id">

                            @alumno.Nombre
                            @alumno.Apellido

                        </option>
                    }

                </select>

            </div>

        </div>


        @if (_cargando)
        {
            <div class="empty-state">
                Cargando seguimiento...
            </div>
        }
        else if (ObservacionesFiltradas.Count == 0)
        {
            <div class="empty-state">

                <div class="empty-icon">
                    ◎
                </div>

                <strong>
                    No hay observaciones registradas
                </strong>

                <p>
                    Los registros de seguimiento aparecerán
                    en esta sección.
                </p>

            </div>
        }
        else
        {
            <div class="observations-list">

                @foreach (var observacion
                    in ObservacionesFiltradas)
                {
                    <article class="observation-card">

                        <aside class="observation-date">

                            <strong>
                                @observacion.FechaHoraObservacion.Day
                            </strong>

                            <span>
                                @ObtenerMesCorto(
                                    observacion.FechaHoraObservacion)
                            </span>

                            <small>
                                @(observacion.FechaHoraObservacion
                                    .ToString("HH:mm"))
                            </small>

                        </aside>


                        <div class="observation-content">

                            <div class="observation-header">

                                <div>

                                    <h3>
                                        @observacion.AlumnoNombre
                                    </h3>

                                    <span>
                                        Registrado por
                                        @observacion.CreadoPorNombre
                                    </span>

                                </div>


                                <span class="observation-date-full">

                                    @(observacion.FechaHoraObservacion
                                        .ToString(
                                            "dd/MM/yyyy · HH:mm"))

                                </span>

                            </div>


                            <div class="observation-context">

                                <span>
                                    Contexto
                                </span>

                                <p>
                                    @observacion.Contexto
                                </p>

                            </div>


                            <div class="behavior-box">

                                <span>
                                    Conducta observada
                                </span>

                                <p>
                                    @observacion.Conducta
                                </p>

                            </div>


                            @if (!string.IsNullOrWhiteSpace(
                                observacion.Antecedente)
                                ||
                                !string.IsNullOrWhiteSpace(
                                    observacion.Consecuencia))
                            {
                                <div class="abc-grid">

                                    @if (!string.IsNullOrWhiteSpace(
                                        observacion.Antecedente))
                                    {
                                        <div>

                                            <span>
                                                Antecedente
                                            </span>

                                            <p>
                                                @observacion.Antecedente
                                            </p>

                                        </div>
                                    }


                                    @if (!string.IsNullOrWhiteSpace(
                                        observacion.Consecuencia))
                                    {
                                        <div>

                                            <span>
                                                Consecuencia
                                            </span>

                                            <p>
                                                @observacion.Consecuencia
                                            </p>

                                        </div>
                                    }

                                </div>
                            }


                            @if (!string.IsNullOrWhiteSpace(
                                observacion.Notas))
                            {
                                <div class="notes-box">

                                    <span>
                                        Notas
                                    </span>

                                    <p>
                                        @observacion.Notas
                                    </p>

                                </div>
                            }

                        </div>
                        @{
                            var intervenciones =
                                IntervencionesDeObservacion(
                                    observacion.Id);
                        }

                        @if (intervenciones.Count > 0)
                        {
                            <div class="interventions-section">

                                <span class="interventions-title">
                                    Intervenciones registradas
                                </span>

                                @foreach (var intervencion in intervenciones)
                                {
                                    <div class="intervention-card">

                                        <div class="intervention-header">

                                            <div>
                                                <strong>
                                                    @intervencion.Estrategia
                                                </strong>

                                                <small>
                                                    @intervencion.FechaHoraIntervencion
                                                        .ToString("dd/MM/yyyy · HH:mm")
                                                </small>
                                            </div>

                                            <button type="button"
                                                    class="btn-result"
                                                    @onclick="() => AbrirResultado(intervencion)">

                                                + Registrar resultado

                                            </button>

                                        </div>


                                        @if (!string.IsNullOrWhiteSpace(
                                            intervencion.Objetivo))
                                        {
                                            <div class="intervention-objective">

                                                <span>
                                                    Objetivo
                                                </span>

                                                <p>
                                                    @intervencion.Objetivo
                                                </p>

                                            </div>
                                        }


                                        @if (intervencion.Resultados.Count > 0)
                                        {
                                            <div class="results-list">

                                                @foreach (var resultado
                                                    in intervencion.Resultados)
                                                {
                                                    <div class="result-card">

                                                        <div class="result-header">

                                                            <strong>
                                                                Resultado
                                                            </strong>

                                                            <span class="effectiveness-badge">
                                                                @resultado.Efectividad
                                                            </span>

                                                        </div>

                                                        <p>
                                                            @resultado.Resultado
                                                        </p>

                                                        @if (!string.IsNullOrWhiteSpace(
                                                            resultado.Notas))
                                                        {
                                                            <small>
                                                                @resultado.Notas
                                                            </small>
                                                        }

                                                        <time>
                                                            @resultado.FechaHoraResultado
                                                                .ToString(
                                                                    "dd/MM/yyyy · HH:mm")
                                                        </time>

                                                    </div>
                                                }

                                            </div>
                                        }

                                    </div>
                                }

                            </div>
                        }
                        <div class="observation-actions">

                            <button type="button"
                                    class="btn-intervention"
                                    @onclick="() => AbrirIntervencion(observacion)">

                                + Registrar intervención

                            </button>

                        </div>

                    </article>
                }

            </div>
        }

    </section>

</div>
@if (_mostrarIntervencion &&
    _observacionSeleccionada is not null)
{
    <div class="modal-overlay">

        <div class="intervention-modal">

            <div class="modal-header-custom">

                <div>
                    <span class="page-eyebrow">
                        Seguimiento
                    </span>

                    <h2>
                        Registrar intervención
                    </h2>

                    <p>
                        @_observacionSeleccionada.AlumnoNombre
                    </p>
                </div>

                <button type="button"
                        class="close-button"
                        @onclick="CerrarIntervencion">
                    ×
                </button>

            </div>


            <div class="observation-reference">

                <span>
                    Observación asociada
                </span>

                <strong>
                    @_observacionSeleccionada.Contexto
                </strong>

                <p>
                    @_observacionSeleccionada.Conducta
                </p>

            </div>


            <div class="form-grid">

                <div class="form-field form-full">

                    <label>
                        Estrategia aplicada
                    </label>

                    <textarea class="form-control"
                              rows="4"
                              maxlength="1500"
                              placeholder="Ej: Se anticipó visualmente el cambio de actividad..."
                              @bind="_intervencionForm.Estrategia">
                    </textarea>

                </div>


                <div class="form-field form-full">

                    <label>
                        Objetivo
                        <span>(opcional)</span>
                    </label>

                    <textarea class="form-control"
                              rows="3"
                              maxlength="1000"
                              placeholder="Ej: Facilitar la transición entre actividades..."
                              @bind="_intervencionForm.Objetivo">
                    </textarea>

                </div>


                <div class="form-field">

                    <label>
                        Fecha y hora
                    </label>

                    <input type="datetime-local"
                           class="form-control"
                           @bind="_fechaIntervencion"
                           @bind:format="yyyy-MM-ddTHH:mm" />

                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(
                _errorIntervencion))
            {
                <div class="alert alert-danger mt-3">
                    @_errorIntervencion
                </div>
            }


            <div class="form-actions">

                <button type="button"
                        class="btn-cancel"
                        @onclick="CerrarIntervencion">

                    Cancelar

                </button>


                <button type="button"
                        class="btn-save"
                        disabled="@_guardandoIntervencion"
                        @onclick="GuardarIntervencion">

                    @(_guardandoIntervencion
                        ? "Registrando..."
                        : "Registrar intervención")

                </button>

            </div>

        </div>

    </div>
}

@if (_mostrarResultado &&
    _intervencionSeleccionada is not null)
{
    <div class="modal-overlay">

        <div class="intervention-modal">

            <div class="modal-header-custom">

                <div>

                    <span class="page-eyebrow">
                        Seguimiento
                    </span>

                    <h2>
                        Registrar resultado
                    </h2>

                    <p>
                        Evalúa el resultado de la estrategia aplicada.
                    </p>

                </div>


                <button type="button"
                        class="close-button"
                        @onclick="CerrarResultado">

                    ×

                </button>

            </div>


            <div class="observation-reference">

                <span>
                    Estrategia aplicada
                </span>

                <strong>
                    @_intervencionSeleccionada.Estrategia
                </strong>

                @if (!string.IsNullOrWhiteSpace(
                    _intervencionSeleccionada.Objetivo))
                {
                    <p>
                        Objetivo:
                        @_intervencionSeleccionada.Objetivo
                    </p>
                }

            </div>


            <div class="form-grid">

                <div class="form-field form-full">

                    <label>
                        Resultado observado
                    </label>

                    <textarea class="form-control"
                              rows="4"
                              maxlength="1500"
                              placeholder="Describe qué ocurrió después de aplicar la estrategia..."
                              @bind="_resultadoForm.Resultado">
                    </textarea>

                </div>


                <div class="form-field">

                    <label>
                        Efectividad
                    </label>

                    <select class="form-select"
                            @bind="_resultadoForm.Efectividad">

                        <option value="">
                            Selecciona
                        </option>

                        <option value="Baja">
                            Baja
                        </option>

                        <option value="Media">
                            Media
                        </option>

                        <option value="Alta">
                            Alta
                        </option>

                    </select>

                </div>


                <div class="form-field">

                    <label>
                        Fecha y hora
                    </label>

                    <input type="datetime-local"
                           class="form-control"
                           @bind="_fechaResultado"
                           @bind:format="yyyy-MM-ddTHH:mm" />

                </div>


                <div class="form-field form-full">

                    <label>
                        Notas
                        <span>(opcional)</span>
                    </label>

                    <textarea class="form-control"
                              rows="3"
                              maxlength="1000"
                              placeholder="Información adicional..."
                              @bind="_resultadoForm.Notas">
                    </textarea>

                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(
                _errorResultado))
            {
                <div class="alert alert-danger mt-3">
                    @_errorResultado
                </div>
            }


            <div class="form-actions">

                <button type="button"
                        class="btn-cancel"
                        @onclick="CerrarResultado">

                    Cancelar

                </button>


                <button type="button"
                        class="btn-save"
                        disabled="@_guardandoResultado"
                        @onclick="GuardarResultado">

                    @(_guardandoResultado
                        ? "Registrando..."
                        : "Registrar resultado")

                </button>

            </div>

        </div>

    </div>
}

@code
{
    private List<AlumnoProfesionalDto> _alumnos =
        new();

    private List<ObservacionConductualDto> _observaciones =
        new();

    private List<IntervencionDto> _intervenciones =
    new();

    private FormObservacion _form =
        new();


    private Guid? _filtroAlumnoId;


    private bool _mostrarFormulario;

    private bool _guardando;

    private bool _cargando =
        true;


    private string _mensaje =
        string.Empty;

    private string _error =
        string.Empty;


    private List<ObservacionConductualDto>
        ObservacionesFiltradas =>
            _observaciones
                .Where(x =>
                    !_filtroAlumnoId.HasValue
                    ||
                    x.AlumnoId ==
                        _filtroAlumnoId.Value)
                .OrderByDescending(x =>
                    x.FechaHoraObservacion)
                .ToList();


    private List<ObservacionConductualDto>
        ObservacionesHoy =>
            _observaciones
                .Where(x =>
                    x.FechaHoraObservacion.Date ==
                        DateTime.Today)
                .ToList();


    private int EstudiantesConSeguimiento =>
        _observaciones
            .Select(x =>
                x.AlumnoId)
            .Distinct()
            .Count();

    private ObservacionConductualDto?
    _observacionSeleccionada;

    private CrearIntervencionRequest
        _intervencionForm =
            new();

    private DateTime _fechaIntervencion =
        DateTime.Now;

    private bool _mostrarIntervencion;

    private bool _guardandoIntervencion;

    private string _errorIntervencion =
        string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private void AbrirIntervencion(
    ObservacionConductualDto observacion)
    {
        _observacionSeleccionada =
            observacion;

        _intervencionForm =
            new CrearIntervencionRequest
            {
                ObservacionId =
                    observacion.Id
            };

        _fechaIntervencion =
            DateTime.Now;

        _errorIntervencion =
            string.Empty;

        _mostrarIntervencion =
            true;
    }

    private void CerrarIntervencion()
    {
        _mostrarIntervencion =
            false;

        _observacionSeleccionada =
            null;

        _intervencionForm =
            new();

        _errorIntervencion =
            string.Empty;
    }

    private async Task GuardarIntervencion()
{
    _errorIntervencion =
        string.Empty;


    if (_observacionSeleccionada is null)
    {
        return;
    }


    if (string.IsNullOrWhiteSpace(
        _intervencionForm.Estrategia))
    {
        _errorIntervencion =
            "Debes indicar la estrategia aplicada.";

        return;
    }


    if (_fechaIntervencion == default)
    {
        _errorIntervencion =
            "La fecha y hora no son válidas.";

        return;
    }


    if (_fechaIntervencion >
        DateTime.Now)
    {
        _errorIntervencion =
            "La intervención no puede tener una fecha futura.";

        return;
    }


    _guardandoIntervencion =
        true;


    try
    {
        var request =
            new CrearIntervencionRequest
            {
                ObservacionId =
                    _observacionSeleccionada.Id,

                FechaHoraIntervencion =
                    DateTime.SpecifyKind(
                        _fechaIntervencion,
                        DateTimeKind.Unspecified),

                Estrategia =
                    _intervencionForm
                        .Estrategia
                        .Trim(),

                Objetivo =
                    LimpiarTexto(
                        _intervencionForm
                            .Objetivo)
            };


        var respuesta =
            await Http.PostAsJsonAsync(
                "api/seguimiento/intervenciones",
                request);


        if (!respuesta.IsSuccessStatusCode)
        {
            var detalle =
                await respuesta.Content
                    .ReadAsStringAsync();

            _errorIntervencion =
                $"No fue posible registrar la intervención. {detalle}";

            return;
        }


        _mensaje =
            "Intervención registrada correctamente.";


        CerrarIntervencion();
        await CargarDatos();
    }
    catch
    {
        _errorIntervencion =
            "No fue posible registrar la intervención.";
    }
    finally
    {
        _guardandoIntervencion =
            false;
    }
}

    private IntervencionDto?
    _intervencionSeleccionada;

    private CrearResultadoIntervencionRequest
        _resultadoForm =
            new();

    private DateTime _fechaResultado =
        DateTime.Now;

    private bool _mostrarResultado;

    private bool _guardandoResultado;

    private string _errorResultado =
        string.Empty;

    private void AbrirResultado(
    IntervencionDto intervencion)
{
    _intervencionSeleccionada =
        intervencion;

    _resultadoForm =
        new CrearResultadoIntervencionRequest
        {
            IntervencionId =
                intervencion.Id
        };

    _fechaResultado =
        DateTime.Now;

    _errorResultado =
        string.Empty;

    _mostrarResultado =
        true;
}
private void CerrarResultado()
{
    _mostrarResultado =
        false;

    _intervencionSeleccionada =
        null;

    _resultadoForm =
        new();

    _errorResultado =
        string.Empty;
}

private async Task GuardarResultado()
{
    _errorResultado =
        string.Empty;


    if (_intervencionSeleccionada is null)
    {
        return;
    }


    if (string.IsNullOrWhiteSpace(
        _resultadoForm.Resultado))
    {
        _errorResultado =
            "Debes describir el resultado observado.";

        return;
    }


    if (string.IsNullOrWhiteSpace(
        _resultadoForm.Efectividad))
    {
        _errorResultado =
            "Debes indicar la efectividad.";

        return;
    }


    if (_fechaResultado == default)
    {
        _errorResultado =
            "La fecha y hora no son válidas.";

        return;
    }


    if (_fechaResultado >
        DateTime.Now)
    {
        _errorResultado =
            "El resultado no puede tener una fecha futura.";

        return;
    }


    if (_fechaResultado <
        _intervencionSeleccionada
            .FechaHoraIntervencion)
    {
        _errorResultado =
            "El resultado no puede ser anterior a la intervención.";

        return;
    }


    _guardandoResultado =
        true;


    try
    {
        var request =
            new CrearResultadoIntervencionRequest
            {
                IntervencionId =
                    _intervencionSeleccionada.Id,

                FechaHoraResultado =
                    DateTime.SpecifyKind(
                        _fechaResultado,
                        DateTimeKind.Unspecified),

                Resultado =
                    _resultadoForm
                        .Resultado
                        .Trim(),

                Efectividad =
                    _resultadoForm
                        .Efectividad
                        .Trim(),

                Notas =
                    LimpiarTexto(
                        _resultadoForm.Notas)
            };


        var respuesta =
            await Http.PostAsJsonAsync(
                "api/seguimiento/resultados-intervencion",
                request);


        if (!respuesta.IsSuccessStatusCode)
        {
            var detalle =
                await respuesta.Content
                    .ReadAsStringAsync();

            _errorResultado =
                $"No fue posible registrar el resultado. {detalle}";

            return;
        }


        _mensaje =
            "Resultado registrado correctamente.";


        CerrarResultado();

        await CargarDatos();
    }
    catch
    {
        _errorResultado =
            "No fue posible registrar el resultado.";
    }
    finally
    {
        _guardandoResultado =
            false;
    }
}

    // Carga alumnos y observaciones autorizadas.
    private async Task CargarDatos()
    {
        _cargando =
            true;

        _error =
            string.Empty;


        try
        {
            var alumnosTask =
                Http.GetFromJsonAsync<
                    List<AlumnoProfesionalDto>>(
                    "api/profesional/alumnos");


            var observacionesTask =
                Http.GetFromJsonAsync<
                    List<ObservacionConductualDto>>(
                    "api/seguimiento/observaciones");


            await Task.WhenAll(
                alumnosTask,
                observacionesTask);


            _alumnos =
                alumnosTask.Result
                ?? new();


            _observaciones =
                observacionesTask.Result
                ?? new();

            var alumnoIds =
                _observaciones
                    .Select(x =>
                        x.AlumnoId)
                    .Distinct()
                    .ToList();


            var tareasIntervenciones =
                alumnoIds
                    .Select(id =>
                        Http.GetFromJsonAsync<
                            List<IntervencionDto>>(
                            $"api/seguimiento/alumnos/{id}/intervenciones"))
                    .ToList();


            var respuestasIntervenciones =
                await Task.WhenAll(
                    tareasIntervenciones);


            _intervenciones =
                respuestasIntervenciones
                    .Where(x =>
                        x is not null)
                    .SelectMany(x =>
                        x!)
                    .ToList();
        }
        catch
        {
            _error =
                "No fue posible cargar el seguimiento.";
        }
        finally
        {
            _cargando =
                false;
        }
    }

    private List<IntervencionDto>
        IntervencionesDeObservacion(
            Guid observacionId)
    {
        return _intervenciones
            .Where(x =>
                x.ObservacionId ==
                    observacionId)
            .OrderByDescending(x =>
                x.FechaHoraIntervencion)
            .ToList();
    }
    private void NuevaObservacion()
    {
        _mensaje =
            string.Empty;

        _error =
            string.Empty;


        _form =
            new FormObservacion
            {
                FechaTexto =
                    FormatearFecha(
                        DateTime.Now)
            };


        _mostrarFormulario =
            true;
    }


    private void CambiarFecha(
        ChangeEventArgs e)
    {
        _form.FechaTexto =
            e.Value?.ToString()
            ?? string.Empty;
    }


    private void CerrarFormulario()
    {
        _mostrarFormulario =
            false;

        _form =
            new FormObservacion();
    }


    private async Task GuardarObservacion()
    {
        _mensaje =
            string.Empty;

        _error =
            string.Empty;


        if (_form.AlumnoId ==
            Guid.Empty)
        {
            _error =
                "Debes seleccionar un estudiante.";

            return;
        }


        if (string.IsNullOrWhiteSpace(
            _form.Contexto))
        {
            _error =
                "Debes indicar el contexto de la observación.";

            return;
        }


        if (string.IsNullOrWhiteSpace(
            _form.Conducta))
        {
            _error =
                "Debes describir la conducta observada.";

            return;
        }


        if (!TryConvertirFecha(
            _form.FechaTexto,
            out var fecha))
        {
            _error =
                "La fecha de observación no es válida.";

            return;
        }


        if (fecha >
            DateTime.Now)
        {
            _error =
                "La observación no puede tener una fecha futura.";

            return;
        }


        _guardando =
            true;


        try
        {
            var request =
                new CrearObservacionConductualRequest
                {
                    AlumnoId =
                        _form.AlumnoId,

                    FechaHoraObservacion =
                        fecha,

                    Contexto =
                        _form.Contexto.Trim(),

                    Conducta =
                        _form.Conducta.Trim(),

                    Antecedente =
                        LimpiarTexto(
                            _form.Antecedente),

                    Consecuencia =
                        LimpiarTexto(
                            _form.Consecuencia),

                    Notas =
                        LimpiarTexto(
                            _form.Notas)
                };


            var respuesta =
                await Http.PostAsJsonAsync(
                    "api/seguimiento/observaciones",
                    request);


            if (!respuesta.IsSuccessStatusCode)
            {
                _error =
                    "No fue posible registrar la observación.";

                return;
            }


            _mensaje =
                "Observación registrada correctamente.";


            CerrarFormulario();

            await CargarDatos();
        }
        catch
        {
            _error =
                "No fue posible registrar la observación.";
        }
        finally
        {
            _guardando =
                false;
        }
    }


    private void CambiarFiltroAlumno(
        ChangeEventArgs e)
    {
        var valor =
            e.Value?.ToString();


        if (string.IsNullOrWhiteSpace(
            valor))
        {
            _filtroAlumnoId =
                null;

            return;
        }


        if (Guid.TryParse(
            valor,
            out var id))
        {
            _filtroAlumnoId =
                id;
        }
    }


    private string ObtenerValorFiltro()
    {
        return _filtroAlumnoId
            ?.ToString()
            ?? string.Empty;
    }


    private bool TryConvertirFecha(
        string valor,
        out DateTime fecha)
    {
        fecha =
            default;


        var formatos =
            new[]
            {
                "yyyy-MM-ddTHH:mm",
                "yyyy-MM-ddTHH:mm:ss"
            };


        if (!DateTime.TryParseExact(
            valor,
            formatos,
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out var resultado))
        {
            return false;
        }


        fecha =
            DateTime.SpecifyKind(
                resultado,
                DateTimeKind.Unspecified);


        return true;
    }


    private string FormatearFecha(
        DateTime fecha)
    {
        return fecha.ToString(
            "yyyy-MM-ddTHH:mm",
            CultureInfo.InvariantCulture);
    }


    private static string? LimpiarTexto(
        string? texto)
    {
        return string.IsNullOrWhiteSpace(
            texto)
                ? null
                : texto.Trim();
    }


    private string ObtenerMesCorto(
        DateTime fecha)
    {
        var meses =
            new[]
            {
                "ENE",
                "FEB",
                "MAR",
                "ABR",
                "MAY",
                "JUN",
                "JUL",
                "AGO",
                "SEP",
                "OCT",
                "NOV",
                "DIC"
            };


        return meses[
            fecha.Month - 1];
    }


    private class FormObservacion
    {
        public Guid AlumnoId { get; set; }

        public string FechaTexto { get; set; }
            = string.Empty;

        public string Contexto { get; set; }
            = string.Empty;

        public string Conducta { get; set; }
            = string.Empty;

        public string Antecedente { get; set; }
            = string.Empty;

        public string Consecuencia { get; set; }
            = string.Empty;

        public string Notas { get; set; }
            = string.Empty;
    }
}