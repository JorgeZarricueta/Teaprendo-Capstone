@page "/profesional/citas"

@layout TEAprendo.Client.Layout.ProfesionalLayout

@using System.Net.Http.Json
@using TEAprendo.Contracts.Citas

@inject HttpClient Http

<PageTitle>Citas - TEAprendo</PageTitle>


<div class="appointments-page">

    <div class="page-header">

        <div>

            <span class="page-eyebrow">
                Comunicación
            </span>

            <h1>
                Citas
            </h1>

            <p>
                Revisa las solicitudes de reunión
                enviadas por los apoderados.
            </p>

        </div>

    </div>

    @if (!string.IsNullOrWhiteSpace(_mensaje))
    {
        <div class="alert alert-success">
            @_mensaje
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">
            @_error
        </div>
    }


    @* =========================
       Resumen
       ========================= *@

    @if (!_cargando)
    {
        <section class="status-grid">

            <article class="status-card">

                <div class="status-icon pending-icon">
                    ◷
                </div>

                <div>
                    <span>Pendientes</span>
                    <strong>@CitasPendientes.Count</strong>
                </div>

            </article>


            <article class="status-card">

                <div class="status-icon accepted-icon">
                    ✓
                </div>

                <div>
                    <span>Aceptadas</span>
                    <strong>@CitasAceptadas.Count</strong>
                </div>

            </article>


            <article class="status-card">

                <div class="status-icon rejected-icon">
                    ×
                </div>

                <div>
                    <span>Rechazadas</span>
                    <strong>@CitasRechazadas.Count</strong>
                </div>

            </article>


            <article class="status-card">

                <div class="status-icon cancelled-icon">
                    –
                </div>

                <div>
                    <span>Canceladas</span>
                    <strong>@CitasCanceladas.Count</strong>
                </div>

            </article>

        </section>
    }


    @if (_cargando)
    {
        <div class="loading-state">

            <div class="loading-spinner"></div>

            <span>
                Cargando solicitudes...
            </span>

        </div>
    }
    else
    {
        @* =========================
           Pendientes
           ========================= *@

        <section class="appointments-section">

            <div class="section-header">

                <div>

                    <span class="page-eyebrow">
                        Requieren atención
                    </span>

                    <h2>
                        Solicitudes pendientes
                    </h2>

                    <p>
                        Citas que todavía no han sido respondidas.
                    </p>

                </div>

            </div>


            @if (CitasPendientes.Count == 0)
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        ✓
                    </div>

                    <strong>
                        No tienes solicitudes pendientes
                    </strong>

                    <p>
                        Las nuevas solicitudes aparecerán
                        automáticamente en esta sección.
                    </p>

                </div>
            }
            else
            {
                <div class="appointments-list">

                    @foreach (var cita in CitasPendientes)
                    {
                        <article class="appointment-card pending-card">

                            <div class="appointment-date">

                                <strong>
                                    @cita.FechaHoraInicio.Day
                                </strong>

                                <span>
                                    @ObtenerMesCorto(
                                        cita.FechaHoraInicio)
                                </span>

                            </div>


                            <div class="appointment-content">

                                <div class="appointment-top">

                                    <div>

                                        <span class="appointment-time">

                                            @(cita.FechaHoraInicio
                                                .ToString("HH:mm"))

                                            -

                                            @(cita.FechaHoraFin
                                                .ToString("HH:mm"))

                                        </span>

                                        <h3>
                                            @cita.AlumnoNombre
                                        </h3>

                                        <span class="guardian-name">
                                            Apoderado:
                                            @cita.ApoderadoNombre
                                        </span>

                                    </div>


                                    <span class="appointment-status pending">
                                        Pendiente
                                    </span>

                                </div>


                                <div class="appointment-info">

                                    <div>

                                        <span>
                                            Fecha
                                        </span>

                                        <strong>
                                            @(cita.FechaHoraInicio
                                                .ToString("dd/MM/yyyy"))
                                        </strong>

                                    </div>


                                    <div>

                                        <span>
                                            Estudiante
                                        </span>

                                        <strong>
                                            @cita.AlumnoNombre
                                        </strong>

                                    </div>

                                </div>


                                <div class="reason">

                                    <span>
                                        Motivo de la solicitud
                                    </span>

                                    <p>
                                        @cita.Motivo
                                    </p>

                                </div>


                                <div class="appointment-actions">

                                    <button type="button"
                                            class="btn-reject"
                                            disabled="@_respondiendo"
                                            @onclick="() => AbrirRespuesta(cita, false)">

                                        Rechazar

                                    </button>


                                    <button type="button"
                                            class="btn-accept"
                                            disabled="@_respondiendo"
                                            @onclick="() => AbrirRespuesta(cita, true)">

                                        Aceptar

                                    </button>

                                </div>


                                @if (_citaRespondiendoId == cita.Id)
                                {
                                    <div class="@ObtenerClasePanelRespuesta()">

                                        <div class="response-form-header">

                                            <div>

                                                <span>
                                                    Responder solicitud
                                                </span>

                                                <strong>
                                                    @(_aceptarRespuesta
                                                        ? "Aceptar cita"
                                                        : "Rechazar cita")
                                                </strong>

                                            </div>


                                            <button type="button"
                                                    class="response-close"
                                                    disabled="@_respondiendo"
                                                    @onclick="CancelarRespuesta">

                                                ×

                                            </button>

                                        </div>


                                        <div class="response-form-body">

                                            <label>
                                                Mensaje para el apoderado
                                                <span>
                                                    (opcional)
                                                </span>
                                            </label>


                                            <textarea class="form-control"
                                                    rows="3"
                                                    maxlength="1000"
                                                    placeholder="@ObtenerPlaceholderRespuesta()"
                                                    @bind="_mensajeRespuesta">
                                            </textarea>


                                            <small>
                                                El apoderado podrá ver este mensaje
                                                junto al estado de la solicitud.
                                            </small>

                                        </div>


                                        <div class="response-form-actions">

                                            <button type="button"
                                                    class="btn-response-cancel"
                                                    disabled="@_respondiendo"
                                                    @onclick="CancelarRespuesta">

                                                Volver

                                            </button>


                                            <button type="button"
                                                    class="@ObtenerClaseBotonConfirmar()"
                                                    disabled="@_respondiendo"
                                                    @onclick="() => ConfirmarRespuesta(cita)">

                                                @(_respondiendo
                                                    ? "Guardando..."
                                                    : _aceptarRespuesta
                                                        ? "Confirmar cita"
                                                        : "Confirmar rechazo")

                                            </button>

                                        </div>

                                    </div>
                                }

                            </div>

                        </article>
                    }

                </div>
            }

        </section>


        @* =========================
           Respondidas
           ========================= *@

        @if (CitasRespondidas.Count > 0)
        {
            <section class="appointments-section history-section">

                <div class="section-header">

                    <div>

                        <span class="page-eyebrow">
                            Historial
                        </span>

                        <h2>
                            Solicitudes respondidas
                        </h2>

                    </div>

                </div>


                <div class="history-list">

                    @foreach (var cita in CitasRespondidas)
                    {
                        <article class="history-card">

                            <div class="history-main">

                                <div class="history-date">

                                    <strong>
                                        @(cita.FechaHoraInicio
                                            .ToString(
                                                "dd/MM/yyyy"))
                                    </strong>

                                    <span>
                                        @(cita.FechaHoraInicio
                                            .ToString("HH:mm"))
                                        -
                                        @(cita.FechaHoraFin
                                            .ToString("HH:mm"))
                                    </span>

                                </div>


                                <div class="history-info">

                                    <strong>
                                        @cita.AlumnoNombre
                                    </strong>

                                    <span>
                                        Apoderado:
                                        @cita.ApoderadoNombre
                                    </span>

                                </div>

                            </div>


                            <span class="@ObtenerClaseEstado(
                                cita.Estado)">

                                @cita.Estado

                            </span>


                            @if (!string.IsNullOrWhiteSpace(
                                cita.MensajeRespuesta))
                            {
                                <p class="history-response">

                                    @cita.MensajeRespuesta

                                </p>
                            }

                        </article>
                    }

                </div>

            </section>
        }


        @* =========================
           Canceladas por Apoderado
           ========================= *@

        @if (CitasCanceladas.Count > 0)
        {
            <section class="appointments-section history-section">

                <div class="section-header">

                    <div>

                        <span class="page-eyebrow">
                            Historial
                        </span>

                        <h2>
                            Solicitudes canceladas
                        </h2>

                    </div>

                </div>


                <div class="history-list">

                    @foreach (var cita in CitasCanceladas)
                    {
                        <article class="history-card cancelled-card">

                            <div class="history-main">

                                <div class="history-date">

                                    <strong>
                                        @(cita.FechaHoraInicio
                                            .ToString(
                                                "dd/MM/yyyy"))
                                    </strong>

                                    <span>
                                        @(cita.FechaHoraInicio
                                            .ToString("HH:mm"))
                                    </span>

                                </div>


                                <div class="history-info">

                                    <strong>
                                        @cita.AlumnoNombre
                                    </strong>

                                    <span>
                                        @cita.ApoderadoNombre
                                    </span>

                                </div>

                            </div>


                            <span class="appointment-status cancelled">
                                Cancelada
                            </span>

                        </article>
                    }

                </div>

            </section>
        }
    }

</div>


@code
{
    private List<CitaDto> _citas =
        new();


    private bool _cargando =
        true;


    private string _error =
        string.Empty;

    private string _mensaje =
    string.Empty;

    private Guid? _citaRespondiendoId;

    private bool _aceptarRespuesta;

    private bool _respondiendo;

    private string _mensajeRespuesta =
        string.Empty;


    private List<CitaDto> CitasPendientes =>
        FiltrarEstado(
            "Pendiente")
            .OrderBy(x =>
                x.FechaHoraInicio)
            .ToList();


    private List<CitaDto> CitasAceptadas =>
        FiltrarEstado(
            "Aceptada");


    private List<CitaDto> CitasRechazadas =>
        FiltrarEstado(
            "Rechazada");


    private List<CitaDto> CitasCanceladas =>
        FiltrarEstado(
            "Cancelada");


    private List<CitaDto> CitasRespondidas =>
        _citas
            .Where(x =>
                x.Estado.Equals(
                    "Aceptada",
                    StringComparison.OrdinalIgnoreCase)
                ||
                x.Estado.Equals(
                    "Rechazada",
                    StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x =>
                x.FechaHoraInicio)
            .ToList();


    protected override async Task OnInitializedAsync()
    {
        await CargarCitas();
    }


    // Obtiene únicamente las solicitudes
    // dirigidas al profesional autenticado.
    private async Task CargarCitas()
    {
        _cargando =
            true;

        _error =
            string.Empty;


        try
        {
            _citas =
                await Http.GetFromJsonAsync<
                    List<CitaDto>>(
                    "api/citas/recibidas")
                ?? new();
        }
        catch
        {
            _error =
                "No fue posible cargar las solicitudes.";
        }
        finally
        {
            _cargando =
                false;
        }
    }


    private List<CitaDto> FiltrarEstado(
        string estado)
    {
        return _citas
            .Where(x =>
                x.Estado.Equals(
                    estado,
                    StringComparison.OrdinalIgnoreCase))
            .ToList();
    }


    private string ObtenerClaseEstado(
        string estado)
    {
        return estado switch
        {
            "Aceptada" =>
                "appointment-status accepted",

            "Rechazada" =>
                "appointment-status rejected",

            "Cancelada" =>
                "appointment-status cancelled",

            _ =>
                "appointment-status pending"
        };
    }

    // Abre el formulario de respuesta.
    private void AbrirRespuesta(
        CitaDto cita,
        bool aceptar)
    {
        _error =
            string.Empty;

        _mensaje =
            string.Empty;

        _citaRespondiendoId =
            cita.Id;

        _aceptarRespuesta =
            aceptar;


        _mensajeRespuesta =
            aceptar
                ? "Confirmada para el horario solicitado."
                : string.Empty;
    }

    private void CancelarRespuesta()
    {
        _citaRespondiendoId =
            null;

        _aceptarRespuesta =
            false;

        _mensajeRespuesta =
            string.Empty;
    }

    // Acepta o rechaza una solicitud pendiente.
    private async Task ConfirmarRespuesta(
        CitaDto cita)
    {
        _error =
            string.Empty;

        _mensaje =
            string.Empty;


        if (_citaRespondiendoId !=
            cita.Id)
        {
            return;
        }


        _respondiendo =
            true;


        try
        {
            var request =
                new ResponderCitaRequest
                {
                    Aceptar =
                        _aceptarRespuesta,

                    Mensaje =
                        string.IsNullOrWhiteSpace(
                            _mensajeRespuesta)
                            ? null
                            : _mensajeRespuesta.Trim()
                };


            var respuesta =
                await Http.PatchAsJsonAsync(
                    $"api/citas/{cita.Id}/responder",
                    request);


            if (!respuesta.IsSuccessStatusCode)
            {
                await ProcesarErrorApi(
                    respuesta);

                return;
            }


            _mensaje =
                _aceptarRespuesta
                    ? "Cita aceptada correctamente."
                    : "Cita rechazada correctamente.";


            CancelarRespuesta();


            await CargarCitas();
        }
        catch
        {
            _error =
                "No fue posible responder la solicitud.";
        }
        finally
        {
            _respondiendo =
                false;
        }
    }

    private async Task ProcesarErrorApi(
        HttpResponseMessage respuesta)
    {
        try
        {
            var error =
                await respuesta.Content
                    .ReadFromJsonAsync<MensajeApi>();


            _error =
                error?.Mensaje
                ?? "No fue posible completar la operación.";
        }
        catch
        {
            _error =
                "No fue posible completar la operación.";
        }
    }

    private string ObtenerClasePanelRespuesta()
    {
        return _aceptarRespuesta
            ? "response-form accept-form"
            : "response-form reject-form";
    }


    private string ObtenerClaseBotonConfirmar()
    {
        return _aceptarRespuesta
            ? "btn-confirm-accept"
            : "btn-confirm-reject";
    }


    private string ObtenerPlaceholderRespuesta()
    {
        return _aceptarRespuesta
            ? "Ej: Confirmada para el horario solicitado."
            : "Ej: No tengo disponibilidad en ese horario.";
    }

    private string ObtenerMesCorto(
        DateTime fecha)
    {
        var meses =
            new[]
            {
                "ENE",
                "FEB",
                "MAR",
                "ABR",
                "MAY",
                "JUN",
                "JUL",
                "AGO",
                "SEP",
                "OCT",
                "NOV",
                "DIC"
            };


        return meses[
            fecha.Month - 1];
    }

    private class MensajeApi
{
    public string Mensaje { get; set; }
        = string.Empty;
}
}