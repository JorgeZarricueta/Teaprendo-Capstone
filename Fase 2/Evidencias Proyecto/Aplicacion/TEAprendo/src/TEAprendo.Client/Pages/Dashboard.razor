@page "/dashboard"

@using System.Net.Http.Json
@using TEAprendo.Client.Services
@using TEAprendo.Contracts.Administracion.Aulas

@inject HttpClient Http
@inject NavigationManager Navigation
@inject SedeContextoService SedeContexto

<PageTitle>Dashboard - TEAprendo</PageTitle>

<div class="dashboard">

    <div class="dashboard-header">
        <h1>Dashboard</h1>

        <p>
            Resumen general de la sede.
        </p>
    </div>


    <div class="dashboard-cards">

        <div class="dashboard-card">

            <span class="dashboard-icon">
                🏫
            </span>

            <div>
                <span>Aulas</span>
                <strong>@_aulas.Count</strong>
            </div>

        </div>


        <div class="dashboard-card">

            <span class="dashboard-icon">
                🎓
            </span>

            <div>
                <span>Alumnos</span>
                <strong>--</strong>
            </div>

        </div>


        <div class="dashboard-card">

            <span class="dashboard-icon">
                👥
            </span>

            <div>
                <span>Usuarios</span>
                <strong>--</strong>
            </div>

        </div>

    </div>


    <section class="dashboard-section">

        <h2>Aulas de la sede</h2>

        @if (_cargando)
        {
            <p>Cargando aulas...</p>
        }
        else if (_aulas.Count == 0)
        {
            <p>
                No hay aulas registradas.
            </p>
        }
        else
        {
            <div class="aulas-grid">

                @foreach (var aula in _aulas)
                {
                    <div class="aula-card">

                        <div class="aula-header">

                            <h3>
                                @aula.Nombre
                            </h3>

                            <span class="estado-aula">
                                @(aula.Activa
                                    ? "Activa"
                                    : "Inactiva")
                            </span>

                        </div>

                        <p>
                            Año académico
                            @aula.AnioAcademico
                        </p>

                    </div>
                }

            </div>
        }

    </section>

</div>

@code
{
    private List<AulaDto> _aulas = new();

    private bool _cargando = true;


    protected override async Task OnInitializedAsync()
    {
        // Obliga a seleccionar una sede.
        if (SedeContexto.SedeActual is null)
        {
            Navigation.NavigateTo(
                "/seleccionar-sede");

            return;
        }

        await CargarAulas();
    }


    // Obtiene las aulas de la sede actual.
    private async Task CargarAulas()
    {
        try
        {
            var sedeId =
                SedeContexto.SedeActual!.Id;

            var aulas =
                await Http.GetFromJsonAsync<List<AulaDto>>(
                    $"api/aulas/sede/{sedeId}");

            _aulas = aulas ?? new();
        }
        finally
        {
            _cargando = false;
        }
    }
}