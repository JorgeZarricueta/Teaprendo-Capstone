@page "/dashboard"

@using System.Net.Http.Json
@using TEAprendo.Client.Services
@using TEAprendo.Contracts.Administracion.Aulas
@using TEAprendo.Contracts.Administracion.Alumnos
@using TEAprendo.Contracts.Administracion.Usuarios

@inject HttpClient Http
@inject NavigationManager Navigation
@inject SedeContextoService SedeContexto

<PageTitle>Panel del Director - TEAprendo</PageTitle>

<div class="director-dashboard">

    <section class="hero-panel">

        <div>
            <span class="eyebrow">
                Panel del Director
            </span>

            <h1>
                Gestión de @_nombreSede
            </h1>

            <p>
                Supervisa estudiantes, aulas y usuarios
                de la sede desde un mismo espacio.
            </p>
        </div>

        <div class="hero-illustration">
            <span>⌂</span>
        </div>

    </section>


    <section class="summary-panel">

        <div class="section-title">
            <span>Resumen institucional</span>
        </div>

        <div class="summary-grid">

            <article class="summary-card green">

                <div class="summary-icon">
                    ◎
                </div>

                <div>
                    <strong>
                        @_cantidadAlumnos
                    </strong>

                    <span>
                        Estudiantes
                    </span>
                </div>

            </article>


            <article class="summary-card lavender">

                <div class="summary-icon">
                    ▦
                </div>

                <div>
                    <strong>
                        @_aulas.Count
                    </strong>

                    <span>
                        Aulas
                    </span>
                </div>

            </article>


            <article class="summary-card pink">

                <div class="summary-icon">
                    ♙
                </div>

                <div>
                    <strong>
                        @_cantidadUsuarios
                    </strong>

                    <span>
                        Usuarios
                    </span>
                </div>

            </article>


            <article class="summary-card cream">

                <div class="summary-icon">
                    ✓
                </div>

                <div>
                    <strong>
                        @_aulasActivas
                    </strong>

                    <span>
                        Aulas activas
                    </span>
                </div>

            </article>

        </div>

    </section>


    <section class="management-grid">

        <article class="management-card">

            <div class="management-header">

                <div>
                    <span class="eyebrow">
                        Gestión
                    </span>

                    <h2>
                        Gestión académica
                    </h2>
                </div>

                <span class="management-icon">
                    ▦
                </span>

            </div>


            <button type="button"
                    class="management-row"
                    @onclick="AbrirAulas">

                <span>Aulas</span>

                <div>
                    <strong>@_aulas.Count</strong>
                    <span>›</span>
                </div>

            </button>


            <button type="button"
                    class="management-row"
                    @onclick="AbrirAlumnos">

                <span>Estudiantes</span>

                <div>
                    <strong>@_cantidadAlumnos</strong>
                    <span>›</span>
                </div>

            </button>

        </article>


        <article class="management-card">

            <div class="management-header">

                <div>
                    <span class="eyebrow">
                        Comunidad
                    </span>

                    <h2>
                        Gestión de usuarios
                    </h2>
                </div>

                <span class="management-icon lavender-icon">
                    ♙
                </span>

            </div>


            <button type="button"
                    class="management-row"
                    @onclick="AbrirUsuarios">

                <span>Usuarios de la sede</span>

                <div>
                    <strong>@_cantidadUsuarios</strong>
                    <span>›</span>
                </div>

            </button>


            <div class="management-row static-row">

                <span>Estado general</span>

                <div>
                    <strong class="status-text">
                        Activo
                    </strong>
                </div>

            </div>

        </article>

    </section>


    <section class="dashboard-section">

        <div class="section-header">

            <div>
                <span class="eyebrow">
                    Organización
                </span>

                <h2>
                    Aulas de la sede
                </h2>

                <p>
                    Revisa las aulas actualmente registradas.
                </p>
            </div>

            <button type="button"
                    class="section-action"
                    @onclick="AbrirAulas">

                Ver todas ›

            </button>

        </div>


        @if (_cargando)
        {
            <div class="empty-state">
                Cargando aulas...
            </div>
        }
        else if (_aulas.Count == 0)
        {
            <div class="empty-state">
                No hay aulas registradas.
            </div>
        }
        else
        {
            <div class="classrooms-grid">

                @foreach (var aula in _aulas.Take(6))
                {
                    <article class="classroom-card">

                        <div class="classroom-top">

                            <div class="classroom-icon">
                                ▦
                            </div>

                            <span class="classroom-status
                                @(aula.Activa ? "active" : "inactive")">

                                @(aula.Activa
                                    ? "Activa"
                                    : "Inactiva")

                            </span>

                        </div>


                        <span class="card-label">
                            Aula
                        </span>

                        <h3>
                            @aula.Nombre
                        </h3>

                        <p>
                            @aula.SedeNombre
                        </p>


                        <div class="classroom-footer">

                            <span>
                                Año académico
                            </span>

                            <strong>
                                @aula.AnioAcademico
                            </strong>

                        </div>

                    </article>
                }

            </div>
        }

    </section>

</div>


@code
{
    private List<AulaDto> _aulas = new();

    private int _cantidadAlumnos;

    private int _cantidadUsuarios;

    private bool _cargando = true;


    private string _nombreSede =>
        SedeContexto.SedeActual?.Nombre
        ?? "la sede";


    private int _aulasActivas =>
        _aulas.Count(x => x.Activa);


    protected override async Task OnInitializedAsync()
    {
        if (SedeContexto.SedeActual is null)
        {
            Navigation.NavigateTo(
                "/seleccionar-sede");

            return;
        }

        await Task.WhenAll(
            CargarAulas(),
            CargarAlumnos(),
            CargarUsuarios());
    }


    private async Task CargarAulas()
    {
        try
        {
            var sedeId =
                SedeContexto.SedeActual!.Id;

            _aulas =
                await Http.GetFromJsonAsync<
                    List<AulaDto>>(
                    $"api/aulas/sede/{sedeId}")
                ?? new();
        }
        finally
        {
            _cargando = false;
        }
    }


    private async Task CargarAlumnos()
    {
        var sedeId =
            SedeContexto.SedeActual!.Id;

        var alumnos =
            await Http.GetFromJsonAsync<
                List<AlumnoDto>>(
                $"api/alumnos/sede/{sedeId}");

        _cantidadAlumnos =
            alumnos?.Count ?? 0;
    }


    private async Task CargarUsuarios()
    {
        var sedeId =
            SedeContexto.SedeActual!.Id;

        var usuarios =
            await Http.GetFromJsonAsync<
                List<UsuarioSedeDto>>(
                $"api/usuarios/sede/{sedeId}");

        _cantidadUsuarios =
            usuarios?.Count ?? 0;
    }


    private void AbrirAulas()
    {
        Navigation.NavigateTo("/aulas");
    }


    private void AbrirAlumnos()
    {
        Navigation.NavigateTo("/alumnos");
    }


    private void AbrirUsuarios()
    {
        Navigation.NavigateTo("/usuarios");
    }
}