@page "/profesional/alumnos/{AlumnoId:guid}"

@layout TEAprendo.Client.Layout.ProfesionalLayout

@using System.Net.Http.Json
@using TEAprendo.Contracts.Profesional

@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Perfil del estudiante - TEAprendo</PageTitle>


@if (_cargando)
{
    <div class="loading-profile">
        Cargando perfil...
    </div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="profile-error">

        <strong>
            No fue posible abrir este estudiante.
        </strong>

        <p>
            @_error
        </p>

        <button class="btn btn-outline-secondary"
                @onclick="Volver">
            Volver a mis alumnos
        </button>

    </div>
}
else if (_alumno is not null)
{
    <div class="student-profile">

        <button class="back-button"
                @onclick="Volver">

            ‹ Volver a mis alumnos

        </button>


        <section class="profile-hero">

            <div class="profile-avatar">
                @ObtenerInicial()
            </div>

            <div class="profile-main-info">

                <span class="profile-label">
                    Estudiante
                </span>

                <h1>
                    @_alumno.Nombre
                    @_alumno.Apellido
                </h1>

                <div class="profile-meta">

                    <span>
                        @_alumno.AulaNombre
                    </span>

                    <span>•</span>

                    <span>
                        @_alumno.SedeNombre
                    </span>

                </div>

            </div>

        </section>


        <section class="profile-grid">

            <article class="info-card">

                <span class="info-label">
                    Fecha de nacimiento
                </span>

                <strong>
                    @_alumno.FechaNacimiento.ToString("dd/MM/yyyy")
                </strong>

                <small>
                    @CalcularEdad(_alumno.FechaNacimiento) años
                </small>

            </article>


            <article class="info-card">

                <span class="info-label">
                    Aula actual
                </span>

                <strong>
                    @_alumno.AulaNombre
                </strong>

                <small>
                    Matrícula activa
                </small>

            </article>


            <article class="info-card">

                <span class="info-label">
                    Establecimiento
                </span>

                <strong>
                    @_alumno.SedeNombre
                </strong>

                <small>
                    Sede actual
                </small>

            </article>

        </section>


        <section class="profile-section">

            <div class="section-heading">

                <div>

                    <span>
                        Seguimiento
                    </span>

                    <h2>
                        Información del estudiante
                    </h2>

                    <p>
                        Desde este espacio se centralizará
                        el seguimiento realizado por los profesionales.
                    </p>

                </div>

            </div>


            <div class="feature-grid">

                <article class="feature-card">

                    <div class="feature-icon">
                        ✎
                    </div>

                    <div>

                        <h3>
                            Observaciones
                        </h3>

                        <p>
                            Registra y consulta observaciones
                            relacionadas con el estudiante.
                        </p>

                    </div>

                    <span class="coming-soon">
                        Próximamente
                    </span>

                </article>


                <article class="feature-card">

                    <div class="feature-icon">
                        ◌
                    </div>

                    <div>

                        <h3>
                            Eventos
                        </h3>

                        <p>
                            Registra eventos importantes y
                            estrategias aplicadas.
                        </p>

                    </div>

                    <span class="coming-soon">
                        Próximamente
                    </span>

                </article>


                <article class="feature-card">

                    <div class="feature-icon">
                        ◫
                    </div>

                    <div>

                        <h3>
                            Informes
                        </h3>

                        <p>
                            Consulta los informes de
                            seguimiento disponibles.
                        </p>

                    </div>

                    <span class="coming-soon">
                        Próximamente
                    </span>

                </article>

            </div>

        </section>

    </div>
}


@code
{
    [Parameter]
    public Guid AlumnoId { get; set; }


    private PerfilAlumnoProfesionalDto? _alumno;

    private bool _cargando = true;

    private string _error = string.Empty;


    protected override async Task OnParametersSetAsync()
    {
        await CargarAlumno();
    }


    // Obtiene el perfil únicamente si existe autorización.
    private async Task CargarAlumno()
    {
        _cargando = true;
        _error = string.Empty;

        try
        {
            var respuesta =
                await Http.GetAsync(
                    $"api/profesional/alumnos/{AlumnoId}");

            if (respuesta.StatusCode ==
                System.Net.HttpStatusCode.Forbidden)
            {
                _error =
                    "No tienes autorización para acceder a este estudiante.";

                return;
            }

            if (respuesta.StatusCode ==
                System.Net.HttpStatusCode.NotFound)
            {
                _error =
                    "El estudiante no fue encontrado.";

                return;
            }

            if (!respuesta.IsSuccessStatusCode)
            {
                _error =
                    "No fue posible obtener la información.";

                return;
            }

            _alumno =
                await respuesta.Content
                    .ReadFromJsonAsync<
                        PerfilAlumnoProfesionalDto>();
        }
        catch
        {
            _error =
                "No fue posible conectar con el servidor.";
        }
        finally
        {
            _cargando = false;
        }
    }


    private void Volver()
    {
        Navigation.NavigateTo(
            "/profesional/alumnos");
    }


    private string ObtenerInicial()
    {
        if (_alumno is null ||
            string.IsNullOrWhiteSpace(_alumno.Nombre))
        {
            return "?";
        }

        return _alumno.Nombre[..1].ToUpper();
    }


    private int CalcularEdad(
        DateTime fechaNacimiento)
    {
        var hoy = DateTime.Today;

        var edad =
            hoy.Year -
            fechaNacimiento.Year;

        if (fechaNacimiento.Date >
            hoy.AddYears(-edad))
        {
            edad--;
        }

        return edad;
    }
}