@page "/profesional"

@layout TEAprendo.Client.Layout.ProfesionalLayout

@using System.Net.Http.Json
@using TEAprendo.Contracts.Profesional

@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Mi espacio - TEAprendo</PageTitle>


@if (_cargando)
{
    <div class="loading-state">

        <div class="loading-circle"></div>

        <span>
            Preparando tu espacio...
        </span>

    </div>
}
else if (!string.IsNullOrWhiteSpace(
    _error))
{
    <div class="error-panel">

        <strong>
            No pudimos cargar tu información
        </strong>

        <span>
            @_error
        </span>

        <button type="button"
                class="retry-button"
                @onclick="CargarResumen">

            Reintentar

        </button>

    </div>
}
else if (_resumen is not null)
{
    <div class="professional-dashboard @ObtenerClaseTema()">


        @* =================================================
           BIENVENIDA
           ================================================= *@

        <section class="professional-hero">

            <div class="hero-content">

                <span class="eyebrow">
                    @ObtenerNombreRol()
                </span>

                <h1>
                    Hola, @_resumen.Nombre
                </h1>

                <p>
                    @ObtenerMensajeBienvenida()
                </p>

            </div>


            <div class="hero-decoration">

                <div class="hero-shape shape-one"></div>

                <div class="hero-shape shape-two"></div>

                <div class="hero-symbol">
                    @(_resumen.Rol == "Docente"
                        ? "✦"
                        : "◇")
                </div>

            </div>

        </section>


        @* =================================================
           RESUMEN
           ================================================= *@

        <section class="stats-grid">

            @if (_resumen.Rol == "Docente")
            {
                <article class="stat-card">

                    <div class="stat-icon stat-primary">
                        ▦
                    </div>

                    <div class="stat-content">

                        <span>
                            Mis aulas
                        </span>

                        <strong>
                            @_resumen.CantidadAulas
                        </strong>

                        <small>
                            Aulas asignadas
                        </small>

                    </div>

                </article>
            }


            <article class="stat-card">

                <div class="stat-icon stat-secondary">
                    ◎
                </div>

                <div class="stat-content">

                    <span>
                        Mis estudiantes
                    </span>

                    <strong>
                        @_resumen.CantidadAlumnos
                    </strong>

                    <small>
                        @ObtenerTextoCantidadAlumnos()
                    </small>

                </div>

            </article>


            <article class="stat-card">

                <div class="stat-icon stat-third">
                    ✓
                </div>

                <div class="stat-content">

                    <span>
                        Seguimiento
                    </span>

                    <strong class="text-stat">
                        Disponible
                    </strong>

                    <small>
                        Registros y observaciones
                    </small>

                </div>

            </article>


            @if (_resumen.Rol != "Docente")
            {
                <article class="stat-card">

                    <div class="stat-icon stat-fourth">
                        ◇
                    </div>

                    <div class="stat-content">

                        <span>
                            Espacio profesional
                        </span>

                        <strong class="text-stat">
                            Activo
                        </strong>

                        <small>
                            Seguimiento individual
                        </small>

                    </div>

                </article>
            }

        </section>


        @* =================================================
           ACCESOS RÁPIDOS
           ================================================= *@

        <section class="quick-actions">

            <button type="button"
                    class="quick-action quick-primary"
                    @onclick="AbrirAlumnos">

                <div class="quick-icon">
                    ◎
                </div>

                <div>

                    <strong>
                        Mis estudiantes
                    </strong>

                    <span>
                        Consulta perfiles y antecedentes.
                    </span>

                </div>

            </button>


            @if (_resumen.Rol == "Docente")
            {
                <button type="button"
                        class="quick-action quick-secondary"
                        @onclick="AbrirAulas">

                    <div class="quick-icon">
                        ▦
                    </div>

                    <div>

                        <strong>
                            Mis aulas
                        </strong>

                        <span>
                            Revisa tus cursos asignados.
                        </span>

                    </div>

                </button>
            }
            else
            {
                <button type="button"
                        class="quick-action quick-secondary"
                        @onclick="AbrirSeguimiento">

                    <div class="quick-icon">
                        ✎
                    </div>

                    <div>

                        <strong>
                            Seguimiento
                        </strong>

                        <span>
                            Observaciones e intervenciones.
                        </span>

                    </div>

                </button>
            }


            <button type="button"
                    class="quick-action quick-third"
                    @onclick="AbrirAgenda">

                <div class="quick-icon">
                    ◫
                </div>

                <div>

                    <strong>
                        Agenda
                    </strong>

                    <span>
                        Revisa tus próximas actividades.
                    </span>

                </div>

            </button>


            <button type="button"
                    class="quick-action quick-fourth"
                    @onclick="AbrirCitas">

                <div class="quick-icon">
                    ◷
                </div>

                <div>

                    <strong>
                        Citas
                    </strong>

                    <span>
                        Gestiona tus encuentros.
                    </span>

                </div>

            </button>

        </section>


        @* =================================================
           AULAS DEL DOCENTE
           ================================================= *@

        @if (_resumen.Rol == "Docente")
        {
            <section class="dashboard-section">

                <div class="section-header">

                    <div>

                        <span class="eyebrow">
                            Organización
                        </span>

                        <h2>
                            Mis aulas
                        </h2>

                        <p>
                            Cursos que actualmente
                            tienes asignados.
                        </p>

                    </div>


                    <span class="section-count">
                        @_resumen.CantidadAulas
                    </span>

                </div>


                @if (_resumen.Aulas.Count == 0)
                {
                    <div class="empty-state">

                        <div class="empty-icon">
                            ▦
                        </div>

                        <strong>
                            Aún no tienes aulas asignadas
                        </strong>

                        <p>
                            Las aulas aparecerán cuando
                            el Director realice una asignación.
                        </p>

                    </div>
                }
                else
                {
                    <div class="classrooms-grid">

                        @foreach (var aula in _resumen.Aulas)
                        {
                            <button type="button"
                                    class="classroom-card"
                                    @onclick="() => AbrirAula(aula.Id)">

                                <div class="classroom-top">

                                    <div class="classroom-icon">
                                        ▦
                                    </div>

                                    <span class="classroom-year">
                                        @aula.AnioAcademico
                                    </span>

                                </div>


                                <div class="classroom-content">

                                    <span class="card-label">
                                        Aula
                                    </span>

                                    <h3>
                                        @aula.Nombre
                                    </h3>

                                    <p>
                                        @aula.SedeNombre
                                    </p>

                                </div>


                                <div class="classroom-footer">

                                    <span>
                                        @ObtenerCantidadAlumnosAula(
                                            aula.Id)
                                        estudiantes
                                    </span>

                                    <strong>
                                        ›
                                    </strong>

                                </div>

                            </button>
                        }

                    </div>
                }

            </section>
        }


        @* =================================================
           ESTUDIANTES
           ================================================= *@

        <section class="dashboard-section">

            <div class="section-header">

                <div>

                    <span class="eyebrow">
                        @(_resumen.Rol == "Docente"
                            ? "Seguimiento"
                            : "Estudiantes asignados")
                    </span>

                    <h2>
                        Mis estudiantes
                    </h2>

                    <p>
                        @ObtenerDescripcionAlumnos()
                    </p>

                </div>


                <span class="section-count">
                    @_resumen.CantidadAlumnos
                </span>

            </div>


            @if (_resumen.Alumnos.Count == 0)
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        ◎
                    </div>

                    <strong>
                        No tienes estudiantes disponibles
                    </strong>

                    <p>
                        @ObtenerMensajeSinAlumnos()
                    </p>

                </div>
            }
            else
            {
                <div class="students-grid">

                    @foreach (var alumno
                        in _resumen.Alumnos)
                    {
                        <article class="student-card">

                            <div class="student-avatar">
                                @ObtenerInicial(
                                    alumno.Nombre)
                            </div>


                            <div class="student-info">

                                <span class="card-label">
                                    Estudiante
                                </span>

                                <h3>
                                    @alumno.Nombre
                                    @alumno.Apellido
                                </h3>

                                <span class="student-class">
                                    @alumno.AulaNombre
                                </span>

                                <small>
                                    @alumno.SedeNombre
                                </small>

                            </div>


                            <button type="button"
                                    class="student-open"
                                    title="Abrir perfil"
                                    @onclick="() => AbrirAlumno(alumno.Id)">

                                ›

                            </button>

                        </article>
                    }

                </div>
            }

        </section>


        @* =================================================
           HERRAMIENTAS
           ================================================= *@

        <section class="dashboard-section">

            <div class="section-header">

                <div>

                    <span class="eyebrow">
                        Herramientas
                    </span>

                    <h2>
                        @(_resumen.Rol == "Docente"
                            ? "Gestión educativa"
                            : "Seguimiento profesional")
                    </h2>

                    <p>
                        Funciones disponibles para
                        acompañar a tus estudiantes.
                    </p>

                </div>

            </div>


            <div class="tools-grid">

                <article class="tool-card">

                    <div class="tool-icon">
                        ✎
                    </div>

                    <div>

                        <strong>
                            Observaciones
                        </strong>

                        <span>
                            Registra antecedentes relevantes
                            del estudiante.
                        </span>

                    </div>

                </article>


                @if (_resumen.Rol == "Docente")
                {
                    <article class="tool-card">

                        <div class="tool-icon">
                            ◫
                        </div>

                        <div>

                            <strong>
                                Aula
                            </strong>

                            <span>
                                Revisa estudiantes y
                                organización del curso.
                            </span>

                        </div>

                    </article>
                }
                else
                {
                    <article class="tool-card">

                        <div class="tool-icon">
                            ◇
                        </div>

                        <div>

                            <strong>
                                Intervenciones
                            </strong>

                            <span>
                                Registra estrategias
                                y sus resultados.
                            </span>

                        </div>

                    </article>
                }


                <article class="tool-card">

                    <div class="tool-icon">
                        ◌
                    </div>

                    <div>

                        <strong>
                            Asistente IA
                        </strong>

                        <span>
                            Consulta antecedentes desde
                            el perfil del estudiante.
                        </span>

                    </div>

                </article>

            </div>

        </section>

    </div>
}


@code
{
    private ResumenProfesionalDto? _resumen;

    private bool _cargando =
        true;

    private string _error =
        string.Empty;


    protected override async Task OnInitializedAsync()
    {
        await CargarResumen();
    }


    // Carga el resumen autorizado.
    private async Task CargarResumen()
    {
        _cargando =
            true;

        _error =
            string.Empty;


        try
        {
            _resumen =
                await Http.GetFromJsonAsync<
                    ResumenProfesionalDto>(
                    "api/profesional/resumen");


            if (_resumen is null)
            {
                _error =
                    "La API no devolvió información del usuario.";
            }
        }
        catch
        {
            _error =
                "No fue posible conectarse con el servidor.";
        }
        finally
        {
            _cargando =
                false;
        }
    }


    private string ObtenerClaseTema()
    {
        return _resumen?.Rol == "Docente"
            ? "theme-docente"
            : "theme-terapeuta";
    }


    private string ObtenerNombreRol()
    {
        return _resumen?.Rol == "Docente"
            ? "Panel del Educador"
            : "Panel del Terapeuta";
    }


    private string ObtenerMensajeBienvenida()
    {
        if (_resumen?.Rol == "Docente")
        {
            return
                "Organiza tus aulas, revisa tus estudiantes y accede rápidamente a sus herramientas de seguimiento.";
        }

        return
            "Revisa tus estudiantes asignados, registra seguimiento y consulta sus antecedentes profesionales.";
    }


    private string ObtenerDescripcionAlumnos()
    {
        if (_resumen?.Rol == "Docente")
        {
            return
                "Estudiantes matriculados actualmente en las aulas que tienes asignadas.";
        }

        return
            "Estudiantes asignados directamente a tu perfil profesional.";
    }


    private string ObtenerMensajeSinAlumnos()
    {
        if (_resumen?.Rol == "Docente")
        {
            return
                "Los estudiantes aparecerán cuando tengas aulas con matrículas activas.";
        }

        return
            "El Director debe asignarte estudiantes para que aparezcan aquí.";
    }


    private string ObtenerTextoCantidadAlumnos()
    {
        if (_resumen?.CantidadAlumnos == 1)
        {
            return
                "Estudiante disponible";
        }

        return
            "Estudiantes disponibles";
    }


    private int ObtenerCantidadAlumnosAula(
        Guid aulaId)
    {
        return _resumen?.Alumnos
            .Count(x =>
                x.AulaId == aulaId)
            ?? 0;
    }


    private string ObtenerInicial(
        string nombre)
    {
        if (string.IsNullOrWhiteSpace(
            nombre))
        {
            return "?";
        }

        return nombre[..1]
            .ToUpper();
    }


    private void AbrirAlumno(
        Guid alumnoId)
    {
        Navigation.NavigateTo(
            $"/profesional/alumnos/{alumnoId}");
    }


    private void AbrirAula(
        Guid aulaId)
    {
        Navigation.NavigateTo(
            $"/profesional/aulas/{aulaId}");
    }


    private void AbrirAlumnos()
    {
        Navigation.NavigateTo(
            "/profesional/alumnos");
    }


    private void AbrirAulas()
    {
        Navigation.NavigateTo(
            "/profesional/aulas");
    }


    private void AbrirAgenda()
    {
        Navigation.NavigateTo(
            "/profesional/agenda");
    }


    private void AbrirCitas()
    {
        Navigation.NavigateTo(
            "/profesional/citas");
    }


    private void AbrirSeguimiento()
    {
        Navigation.NavigateTo(
            "/profesional/seguimiento");
    }
}