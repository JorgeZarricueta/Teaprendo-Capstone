@page "/profesional/aulas/{AulaId:guid}"

@layout TEAprendo.Client.Layout.ProfesionalLayout

@using System.Net.Http.Json
@using TEAprendo.Contracts.IA
@using TEAprendo.Contracts.Profesional

@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Aula - TEAprendo</PageTitle>


@if (_cargando)
{
    <div class="loading-panel">
        Cargando aula...
    </div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="error-panel">

        <strong>
            No fue posible abrir el aula.
        </strong>

        <p>
            @_error
        </p>

        <button class="btn btn-outline-secondary"
                @onclick="Volver">
            Volver
        </button>

    </div>
}
else if (_aula is not null)
{
    <div class="aula-detail-page">

        <button class="back-button"
                @onclick="Volver">

            ‹ Volver a mis aulas

        </button>


        <section class="aula-hero">

            <div class="hero-icon">
                ▦
            </div>

            <div class="hero-content">

                <span class="hero-label">
                    Aula asignada
                </span>

                <h1>
                    @_aula.Nombre
                </h1>

                <p>
                    @_aula.SedeNombre
                    ·
                    Año académico @_aula.AnioAcademico
                </p>

            </div>

            <button class="assistant-open-button"
                    @onclick="AbrirAsistente">
                <span aria-hidden="true">✦</span>
                Asistente IA
            </button>

        </section>


        <section class="aula-summary">

            <article>

                <span>
                    Estudiantes
                </span>

                <strong>
                    @_aula.Alumnos.Count
                </strong>

            </article>

            <article>

                <span>
                    Año académico
                </span>

                <strong>
                    @_aula.AnioAcademico
                </strong>

            </article>

        </section>


        <section class="students-section">

            <div class="section-heading">

                <div>

                    <span>
                        Estudiantes
                    </span>

                    <h2>
                        Alumnos del aula
                    </h2>

                    <p>
                        Estudiantes con matrícula activa
                        en esta aula.
                    </p>

                </div>

            </div>


            @if (_aula.Alumnos.Count == 0)
            {
                <div class="empty-state">

                    <strong>
                        No hay alumnos matriculados
                    </strong>

                    <p>
                        Los estudiantes aparecerán
                        automáticamente cuando exista
                        una matrícula activa.
                    </p>

                </div>
            }
            else
            {
                <div class="students-grid">

                    @foreach (var alumno in _aula.Alumnos)
                    {
                        <button class="student-card"
                                @onclick="() => AbrirAlumno(alumno.Id)">

                            <div class="student-avatar">
                                @ObtenerInicial(alumno.Nombre)
                            </div>

                            <div class="student-info">

                                <h3>
                                    @alumno.Nombre
                                    @alumno.Apellido
                                </h3>

                                <span>
                                    @alumno.AulaNombre
                                </span>

                            </div>

                            <div class="student-arrow">
                                ›
                            </div>

                        </button>
                    }

                </div>
            }

        </section>

    </div>

    @if (_asistenteAbierto)
    {
        <div class="assistant-backdrop" @onclick="CerrarAsistente">
            <section class="assistant-panel"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="assistant-title"
                     @onclick:stopPropagation>
                <header class="assistant-header">
                    <div>
                        <span class="assistant-status"><i></i> Aula @_aula.Nombre</span>
                        <h2 id="assistant-title">Asistente educativo</h2>
                    </div>
                    <button class="assistant-close"
                            @onclick="CerrarAsistente"
                            aria-label="Cerrar asistente">&times;</button>
                </header>

                <div class="assistant-messages"
                     aria-live="polite"
                     @ref="_contenedorMensajes">
                    @if (_mensajes.Count == 0)
                    {
                        <div class="assistant-welcome">
                            <div class="assistant-mark">✦</div>
                            <strong>Contexto preparado para @_aula.Nombre</strong>
                            <p>Las respuestas se basarán únicamente en observaciones autorizadas de esta aula.</p>
                            <div class="suggested-prompts">
                                <button @onclick="SugerirPlasticina">Actividad con plasticina</button>
                                <button @onclick="SugerirRuido">Actividad con ruido</button>
                                <button @onclick="SugerirTransicion">Preparar una transición</button>
                            </div>
                        </div>
                    }

                    @foreach (var mensaje in _mensajes)
                    {
                        <article class="chat-message @(mensaje.EsUsuario ? "user-message" : "assistant-message")">
                            <div class="message-role">@(mensaje.EsUsuario ? "Tú" : "TEAprendo")</div>
                            <div class="message-content">@mensaje.Texto</div>
                            @if (!mensaje.EsUsuario && mensaje.Fuentes > 0)
                            {
                                <div class="message-sources">@mensaje.Fuentes antecedentes considerados</div>
                            }
                        </article>
                    }

                    @if (_consultando)
                    {
                        <div class="assistant-thinking">
                            <span></span><span></span><span></span>
                            <label>Revisando antecedentes del aula...</label>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_errorAsistente))
                {
                    <div class="assistant-error">@_errorAsistente</div>
                }

                <form class="assistant-composer"
                      @onsubmit="EnviarPregunta"
                      @onsubmit:preventDefault>
                    <label for="assistant-question">Pregunta para el aula @_aula.Nombre</label>
                    <div class="composer-row">
                        <textarea id="assistant-question"
                                  rows="2"
                                  maxlength="1000"
                                  placeholder="Escribe una consulta sobre una actividad o situación..."
                                  @bind="_pregunta"
                                  @bind:event="oninput"
                                  disabled="@_consultando"></textarea>
                        <button type="submit"
                                disabled="@(_consultando || string.IsNullOrWhiteSpace(_pregunta))"
                                aria-label="Enviar pregunta">
                            <span aria-hidden="true">↑</span>
                        </button>
                    </div>
                    <small>Orientación educativa basada en antecedentes; no constituye diagnóstico.</small>
                </form>
            </section>
        </div>
    }
}


@code
{
    [Parameter]
    public Guid AulaId { get; set; }


    private DetalleAulaProfesionalDto? _aula;

    private bool _cargando = true;

    private string _error = string.Empty;

    private readonly List<MensajeChat> _mensajes = [];

    private bool _asistenteAbierto;

    private bool _consultando;

    private string _pregunta = string.Empty;

    private string _errorAsistente = string.Empty;

    private ElementReference _contenedorMensajes;

    private bool _desplazarChat;


    protected override async Task OnParametersSetAsync()
    {
        await CargarAula();
    }


    // Obtiene el aula únicamente si pertenece al Docente.
    private async Task CargarAula()
    {
        _cargando = true;
        _error = string.Empty;

        try
        {
            var respuesta =
                await Http.GetAsync(
                    $"api/profesional/aulas/{AulaId}");

            if (respuesta.StatusCode ==
                System.Net.HttpStatusCode.Forbidden)
            {
                _error =
                    "No tienes autorización para acceder a esta aula.";

                return;
            }

            if (respuesta.StatusCode ==
                System.Net.HttpStatusCode.NotFound)
            {
                _error =
                    "El aula no fue encontrada.";

                return;
            }

            if (!respuesta.IsSuccessStatusCode)
            {
                _error =
                    "No fue posible obtener la información.";

                return;
            }

            _aula =
                await respuesta.Content
                    .ReadFromJsonAsync<
                        DetalleAulaProfesionalDto>();
        }
        catch
        {
            _error =
                "No fue posible conectar con el servidor.";
        }
        finally
        {
            _cargando = false;
        }
    }


    private void AbrirAlumno(Guid alumnoId)
    {
        Navigation.NavigateTo(
            $"/profesional/alumnos/{alumnoId}");
    }


    private void AbrirAsistente()
    {
        _asistenteAbierto = true;
        _errorAsistente = string.Empty;
    }


    private void CerrarAsistente()
    {
        if (!_consultando)
        {
            _asistenteAbierto = false;
        }
    }


    private void UsarSugerencia(string pregunta)
    {
        _pregunta = pregunta;
    }


    private void SugerirPlasticina() =>
        UsarSugerencia(
            "Quiero realizar una actividad con plasticina de colores. ¿Qué debo considerar?");


    private void SugerirRuido() =>
        UsarSugerencia(
            "¿Qué apoyos han funcionado durante actividades con mucho ruido?");


    private void SugerirTransicion() =>
        UsarSugerencia(
            "¿Qué estrategias han ayudado en cambios de actividad o transiciones?");


    private async Task EnviarPregunta()
    {
        var pregunta = _pregunta.Trim();

        if (_consultando ||
            string.IsNullOrWhiteSpace(pregunta))
        {
            return;
        }

        _consultando = true;
        _errorAsistente = string.Empty;
        _pregunta = string.Empty;
        var historial = _mensajes
            .TakeLast(6)
            .Select(x => new MensajeHistorialIaDto
            {
                EsUsuario = x.EsUsuario,
                Texto = x.Texto.Length <= 4000
                    ? x.Texto
                    : x.Texto[..4000]
            })
            .ToList();
        _mensajes.Add(new MensajeChat(true, pregunta));
        _desplazarChat = true;

        try
        {
            var respuesta = await Http.PostAsJsonAsync(
                "api/ia/contexto/chat/aula",
                new SolicitudContextoAulaRequest
                {
                    AulaId = AulaId,
                    Pregunta = pregunta,
                    MaxObservaciones = 20,
                    Historial = historial
                });

            if (!respuesta.IsSuccessStatusCode)
            {
                _errorAsistente = respuesta.StatusCode ==
                    System.Net.HttpStatusCode.ServiceUnavailable
                    ? "El asistente local no está disponible. Comprueba que TEAprendo.AI y Ollama estén iniciados."
                    : "No fue posible responder la consulta.";

                return;
            }

            var resultado = await respuesta.Content
                .ReadFromJsonAsync<RespuestaAsistenteIaDto>();

            if (resultado is null ||
                string.IsNullOrWhiteSpace(resultado.Respuesta))
            {
                _errorAsistente =
                    "El asistente devolvió una respuesta vacía.";

                return;
            }

            _mensajes.Add(new MensajeChat(
                false,
                resultado.Respuesta,
                resultado.ObservacionesFuente.Count));
            _desplazarChat = true;
        }
        catch
        {
            _errorAsistente =
                "No fue posible conectar con el asistente local.";
        }
        finally
        {
            _consultando = false;
        }
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_desplazarChat)
        {
            _desplazarChat = false;
            await JS.InvokeVoidAsync(
                "teaprendoChat.scrollToEnd",
                _contenedorMensajes);
        }
    }


    private void Volver()
    {
        Navigation.NavigateTo(
            "/profesional/aulas");
    }


    private string ObtenerInicial(string nombre)
    {
        return string.IsNullOrWhiteSpace(nombre)
            ? "?"
            : nombre[..1].ToUpper();
    }


    private sealed record MensajeChat(
        bool EsUsuario,
        string Texto,
        int Fuentes = 0);
}
