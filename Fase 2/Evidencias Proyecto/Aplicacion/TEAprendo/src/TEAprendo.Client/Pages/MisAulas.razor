@page "/profesional/aulas"

@layout TEAprendo.Client.Layout.ProfesionalLayout

@using System.Net.Http.Json
@using TEAprendo.Contracts.Profesional

@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Mis aulas - TEAprendo</PageTitle>


<div class="mis-aulas-page">

    <div class="page-heading">

        <div>

            <span class="page-eyebrow">
                Mi trabajo
            </span>

            <h1>
                Mis aulas
            </h1>

            <p>
                Revisa las aulas que tienes actualmente
                asignadas y sus estudiantes.
            </p>

        </div>

        @if (!_cargando)
        {
            <div class="total-aulas">

                <strong>
                    @_aulas.Count
                </strong>

                <span>
                    aulas
                </span>

            </div>
        }

    </div>


    @if (_cargando)
    {
        <div class="loading-panel">
            Cargando tus aulas...
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">
            @_error
        </div>
    }
    else if (_aulas.Count == 0)
    {
        <div class="empty-state">

            <div class="empty-icon">
                ▦
            </div>

            <strong>
                No tienes aulas asignadas
            </strong>

            <p>
                El Director debe asignarte una o más aulas.
            </p>

        </div>
    }
    else
    {
        <div class="aulas-grid">

            @foreach (var aula in _aulas)
            {
                <button class="aula-card"
                        @onclick="() => AbrirAula(aula.Id)">

                    <div class="aula-top">

                        <div class="aula-icon">
                            ▦
                        </div>

                        <span class="aula-year">
                            @aula.AnioAcademico
                        </span>

                    </div>


                    <div class="aula-info">

                        <h2>
                            @aula.Nombre
                        </h2>

                        <span>
                            @aula.SedeNombre
                        </span>

                    </div>


                    <div class="aula-action">

                        <span>
                            Ver estudiantes
                        </span>

                        <strong>
                            ›
                        </strong>

                    </div>

                </button>
            }

        </div>
    }

</div>


@code
{
    private List<AulaProfesionalDto> _aulas = new();

    private bool _cargando = true;

    private string _error = string.Empty;


    protected override async Task OnInitializedAsync()
    {
        await CargarAulas();
    }


    // Carga únicamente las aulas asignadas al Docente.
    private async Task CargarAulas()
    {
        _cargando = true;
        _error = string.Empty;

        try
        {
            var aulas =
                await Http.GetFromJsonAsync<
                    List<AulaProfesionalDto>>(
                    "api/profesional/aulas");

            _aulas =
                aulas ?? new();
        }
        catch
        {
            _error =
                "No fue posible cargar tus aulas.";
        }
        finally
        {
            _cargando = false;
        }
    }


    private void AbrirAula(Guid aulaId)
    {
        Navigation.NavigateTo(
            $"/profesional/aulas/{aulaId}");
    }
}