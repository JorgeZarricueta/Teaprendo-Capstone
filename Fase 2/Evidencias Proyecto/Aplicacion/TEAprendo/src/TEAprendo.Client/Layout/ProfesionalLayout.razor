@inherits LayoutComponentBase

@using TEAprendo.Client.Services
@using TEAprendo.Client.Components

@inject HttpClient Http
@inject NavigationManager Navigation
@inject SesionService Sesion
@inject SedeContextoService SedeContexto


<div class="professional-shell">

    <header class="app-header">

        @* =========================
           Barra superior
           ========================= *@

        <div class="app-topbar">

            <div class="app-brand">

                <div class="brand-mark">
                    T
                </div>

                <div class="brand-copy">

                    <strong>
                        TEAprendo
                    </strong>

                    <span>
                        @ObtenerSubtituloPortal()
                    </span>

                </div>

            </div>


            <div class="topbar-right">

                <CampanaNotificaciones />


                <div class="user-area">

                    <div class="user-copy">

                        <strong>
                            @_nombreUsuario
                        </strong>

                        <span>
                            @_rolUsuario
                        </span>

                    </div>


                    <div class="user-avatar">
                        @_inicial
                    </div>

                </div>


                <button type="button"
                        class="logout-button"
                        title="Cerrar sesión"
                        @onclick="CerrarSesion">

                    ↪

                </button>

            </div>

        </div>


        @* =========================
           Marcadores de navegación
           ========================= *@

        <div class="role-tabs-wrapper">

            <nav class="role-tabs">


                <NavLink href="/profesional"
                         Match="NavLinkMatch.All"
                         class="role-tab">

                    <span class="tab-icon">
                        ⌂
                    </span>

                    <span>
                        Inicio
                    </span>

                </NavLink>


                <NavLink href="/profesional/alumnos"
                         class="role-tab">

                    <span class="tab-icon">
                        ◎
                    </span>

                    <span>
                        Estudiantes
                    </span>

                </NavLink>


                @if (_esDocente)
                {
                    <NavLink href="/profesional/aulas"
                             class="role-tab">

                        <span class="tab-icon">
                            ▦
                        </span>

                        <span>
                            Aulas
                        </span>

                    </NavLink>
                }


                <NavLink href="/profesional/agenda"
                         class="role-tab">

                    <span class="tab-icon">
                        ◫
                    </span>

                    <span>
                        Agenda
                    </span>

                </NavLink>


                <NavLink href="/profesional/citas"
                         class="role-tab">

                    <span class="tab-icon">
                        ◷
                    </span>

                    <span>
                        Citas
                    </span>

                </NavLink>


                <NavLink href="/profesional/seguimiento"
                         class="role-tab">

                    <span class="tab-icon">
                        ✎
                    </span>

                    <span>
                        Seguimiento
                    </span>

                </NavLink>


                @if (!_esDocente)
                {
                    <div class="role-tab role-tab-info">

                        <span class="tab-icon">
                            ◇
                        </span>

                        <span>
                            Intervenciones
                        </span>

                    </div>
                }

            </nav>

        </div>

    </header>


    @* =========================
       Contenido
       ========================= *@

    <main class="professional-main">

        <div class="page-context">

            <span>
                @ObtenerTituloRol()
            </span>

        </div>


        <section class="professional-content">

            @Body

        </section>

    </main>

</div>


@code
{
    private string _nombreUsuario =
        "Usuario";

    private string _rolUsuario =
        string.Empty;

    private string _inicial =
        "?";

    private bool _esDocente;


    protected override async Task OnInitializedAsync()
    {
        var usuario =
            Sesion.UsuarioActual
            ?? await Sesion.CargarAsync();


        if (usuario is null)
        {
            Navigation.NavigateTo(
                "/login",
                true);

            return;
        }


        var esDocente =
            usuario.Roles.Contains(
                "Docente");

        var esTerapeuta =
            usuario.Roles.Contains(
                "Terapeuta");


        if (!esDocente &&
            !esTerapeuta)
        {
            Navigation.NavigateTo(
                "/seleccionar-sede");

            return;
        }


        _esDocente =
            esDocente;


        _rolUsuario =
            esDocente
                ? "Docente"
                : "Terapeuta";


        _nombreUsuario =
            $"{usuario.Nombre} {usuario.Apellido}";


        if (!string.IsNullOrWhiteSpace(
            usuario.Nombre))
        {
            _inicial =
                usuario.Nombre[..1]
                    .ToUpper();
        }
    }


    private string ObtenerTituloRol()
    {
        return _esDocente
            ? "Panel del Educador"
            : "Panel del Terapeuta";
    }


    private string ObtenerSubtituloPortal()
    {
        return _esDocente
            ? "Espacio educativo"
            : "Espacio profesional";
    }


    private async Task CerrarSesion()
    {
        try
        {
            await Http.PostAsync(
                "api/autenticacion/logout",
                null);
        }
        catch
        {
            // La sesión local se limpia igualmente.
        }


        Sesion.Limpiar();

        SedeContexto.Limpiar();


        Navigation.NavigateTo(
            "/login",
            true);
    }
}