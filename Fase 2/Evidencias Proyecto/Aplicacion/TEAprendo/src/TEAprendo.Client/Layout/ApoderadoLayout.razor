@inherits LayoutComponentBase

@using TEAprendo.Client.Services
@using TEAprendo.Client.Components

@inject HttpClient Http
@inject NavigationManager Navigation
@inject SesionService Sesion
@inject SedeContextoService SedeContexto


<div class="guardian-shell">

    <header class="app-header">

        <div class="app-topbar">

            <div class="app-brand">

                <div class="brand-mark">
                    T
                </div>

                <div class="brand-copy">

                    <strong>
                        TEAprendo
                    </strong>

                    <span>
                        Portal familiar
                    </span>

                </div>

            </div>


            <div class="topbar-right">

                <CampanaNotificaciones />


                <div class="user-area">

                    <div class="user-copy">

                        <strong>
                            @_nombreUsuario
                        </strong>

                        <span>
                            Apoderado
                        </span>

                    </div>


                    <div class="user-avatar">
                        @_inicial
                    </div>

                </div>


                <button type="button"
                        class="logout-button"
                        title="Cerrar sesión"
                        @onclick="CerrarSesion">

                    ↪

                </button>

            </div>

        </div>


        @* =========================
           Marcadores
           ========================= *@

        <div class="role-tabs-wrapper">

            <nav class="role-tabs">


                <NavLink href="/apoderado"
                         Match="NavLinkMatch.All"
                         class="role-tab">

                    <span class="tab-icon">
                        ⌂
                    </span>

                    <span>
                        Inicio
                    </span>

                </NavLink>


                <div class="role-tab role-tab-info">

                    <span class="tab-icon">
                        ◎
                    </span>

                    <span>
                        Mi estudiante
                    </span>

                </div>


                <NavLink href="/apoderado/citas"
                         class="role-tab">

                    <span class="tab-icon">
                        ◷
                    </span>

                    <span>
                        Citas
                    </span>

                </NavLink>


                <div class="role-tab role-tab-info">

                    <span class="tab-icon">
                        ◫
                    </span>

                    <span>
                        Comunicados
                    </span>

                </div>


                <div class="role-tab role-tab-info">

                    <span class="tab-icon">
                        ◇
                    </span>

                    <span>
                        Mensajes
                    </span>

                </div>

            </nav>

        </div>

    </header>


    <main class="guardian-main">

        <div class="page-context">

            <span>
                Panel del Apoderado
            </span>

        </div>


        <section class="guardian-content">

            @Body

        </section>

    </main>

</div>


@code
{
    private string _nombreUsuario =
        "Apoderado";

    private string _inicial =
        "?";


    protected override async Task OnInitializedAsync()
    {
        var usuario =
            Sesion.UsuarioActual
            ?? await Sesion.CargarAsync();


        if (usuario is null)
        {
            Navigation.NavigateTo(
                "/login",
                true);

            return;
        }


        var esApoderado =
            usuario.Roles.Contains(
                "Apoderado",
                StringComparer.OrdinalIgnoreCase);


        if (!esApoderado)
        {
            Navigation.NavigateTo(
                "/seleccionar-sede");

            return;
        }


        _nombreUsuario =
            $"{usuario.Nombre} {usuario.Apellido}";


        if (!string.IsNullOrWhiteSpace(
            usuario.Nombre))
        {
            _inicial =
                usuario.Nombre[..1]
                    .ToUpper();
        }
    }


    private async Task CerrarSesion()
    {
        try
        {
            await Http.PostAsync(
                "api/autenticacion/logout",
                null);
        }
        catch
        {
        }


        Sesion.Limpiar();

        SedeContexto.Limpiar();


        Navigation.NavigateTo(
            "/login",
            true);
    }
}