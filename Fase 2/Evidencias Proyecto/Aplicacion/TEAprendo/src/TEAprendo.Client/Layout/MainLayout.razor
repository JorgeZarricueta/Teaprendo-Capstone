@inherits LayoutComponentBase

@using System.Net.Http.Json
@using TEAprendo.Client.Services
@using TEAprendo.Contracts.Autenticacion

@inject HttpClient Http
@inject NavigationManager Navigation
@inject SedeContextoService SedeContexto


<div class="director-shell">

    <header class="app-header">

        <div class="app-topbar">

            <div class="app-brand">

                <div class="brand-mark">
                    T
                </div>

                <div class="brand-copy">

                    <strong>
                        TEAprendo
                    </strong>

                    <span>
                        Gestión institucional
                    </span>

                </div>

            </div>


            <div class="topbar-center">

                @if (SedeContexto.SedeActual is not null)
                {
                    <div class="site-context">

                        <span>
                            Sede actual
                        </span>

                        <strong>
                            @SedeContexto.SedeActual.Nombre
                        </strong>

                        <small>
                            @SedeContexto.SedeActual.InstitucionNombre
                        </small>

                    </div>
                }

            </div>


            <div class="topbar-right">

                @if (_usuario is not null)
                {
                    <div class="user-area">

                        <div class="user-copy">

                            <strong>
                                @_usuario.Nombre
                                @_usuario.Apellido
                            </strong>

                            <span>
                                @ObtenerRol()
                            </span>

                        </div>


                        <div class="user-avatar">
                            @ObtenerInicial()
                        </div>

                    </div>
                }


                <button type="button"
                        class="logout-button"
                        title="Cerrar sesión"
                        @onclick="CerrarSesion">

                    ↪

                </button>

            </div>

        </div>


        @* =========================
           Marcadores
           ========================= *@

        <div class="role-tabs-wrapper">

            <nav class="role-tabs">


                <NavLink href="/dashboard"
                         Match="NavLinkMatch.All"
                         class="role-tab">

                    <span class="tab-icon">
                        ⌂
                    </span>

                    <span>
                        Inicio
                    </span>

                </NavLink>


                <NavLink href="/aulas"
                         class="role-tab">

                    <span class="tab-icon">
                        ▦
                    </span>

                    <span>
                        Aulas
                    </span>

                </NavLink>


                <NavLink href="/alumnos"
                         class="role-tab">

                    <span class="tab-icon">
                        ◎
                    </span>

                    <span>
                        Alumnos
                    </span>

                </NavLink>


                <NavLink href="/usuarios"
                         class="role-tab">

                    <span class="tab-icon">
                        ♙
                    </span>

                    <span>
                        Usuarios
                    </span>

                </NavLink>


                <div class="role-tab role-tab-info">

                    <span class="tab-icon">
                        ◇
                    </span>

                    <span>
                        Asignaciones
                    </span>

                </div>

            </nav>

        </div>

    </header>


    <main class="director-main">

        <div class="page-context">

            <span>
                Panel del Director
            </span>

        </div>


        <section class="director-content">

            @Body

        </section>

    </main>

</div>


@code
{
    private UsuarioActualDto? _usuario;


    protected override async Task OnInitializedAsync()
    {
        await CargarUsuario();
    }


    private async Task CargarUsuario()
    {
        try
        {
            _usuario =
                await Http.GetFromJsonAsync<
                    UsuarioActualDto>(
                    "api/autenticacion/usuario-actual");
        }
        catch
        {
            Navigation.NavigateTo(
                "/login");
        }
    }


    private string ObtenerRol()
    {
        if (_usuario is null ||
            _usuario.Roles.Count == 0)
        {
            return string.Empty;
        }

        var rol =
            _usuario.Roles[0];

        return rol == "Administrador"
            ? "Director"
            : rol;
    }


    private string ObtenerInicial()
    {
        if (_usuario is null ||
            string.IsNullOrWhiteSpace(
                _usuario.Nombre))
        {
            return "?";
        }

        return _usuario.Nombre[..1]
            .ToUpper();
    }


    private async Task CerrarSesion()
    {
        await Http.PostAsync(
            "api/autenticacion/logout",
            null);

        SedeContexto.Limpiar();

        Navigation.NavigateTo(
            "/login");
    }
}